{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=postgres;Username=postgres;Password=12345"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "JwtSettings": {
    "SecretKey": "WARDROBE_SUPER_SECRET_KEY_2026_256_BITS",
    "Issuer": "Wardrobe.API",
    "Audience": "Wardrobe.Client",
    "ExpirationInMinutes": 60
  },

  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],

    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },

    "WriteTo": [
      {
        "Name": "Console"
      },

      {
        "Name": "File",

        "Args": {
          "path": "Logs/log-.txt",

          "rollingInterval": "Day",

          "retainedFileCountLimit": 30,

          "shared": true
        }
      }
    ],

    "Enrich": [
      "FromLogContext"
    ]
  }
}